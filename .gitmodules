[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "edetect"]
	path = edetect
	url = https://github.com/castlaboratory/edetect
[submodule "fieldopt"]
	path = fieldopt
	url = https://github.com/castlaboratory/fieldopt
[submodule "seqbench"]
	path = seqbench
	url = https://github.com/castlaboratory/seqbench
[submodule "shewhartr"]
	path = shewhartr
	url = https://github.com/castlaboratory/shewhartr
